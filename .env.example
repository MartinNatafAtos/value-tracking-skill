# --- Provider LLM : anthropic | openai | azure ---
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Optionnel : provider azure (nécessite un déploiement Azure OpenAI existant)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# --- Stores locaux ---
LOCAL_DOCS_DIR=./local-docs
HISTORY_JSON_PATH=./local-history.json
MEMORY_DIR=./local-memory
R1_MAPPING_CACHE=./.r1_mapping_cache.json

# --- Anonymisation ---
PII_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,IBAN
CLIENT_NAMES=

# --- Serveur HTTP (optionnel) ---
# Si définie, /analyze et /upload-r1 exigent le header X-API-Key.
API_KEY=
